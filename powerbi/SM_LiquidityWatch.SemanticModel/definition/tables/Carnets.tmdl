	partition 'Carnets' = m
		mode: import
		source =
				let
					Source = AzureDataExplorer.Contents(Cluster, Base, "lw_book_silver | summarize spread_bps = round(avg(spread_bps), 3), depth_5bps = avg(depth_5bps), depth_20bps = avg(depth_20bps), mid = avg(mid), mid_min = min(mid), imbalance = round(avg(imbalance_5bps), 3), latency_ms = round(avg(latency_ms), 1), carnets = count(), choc = countif(scenario == ""STRESS_TEST"") by venue, symbol, minute = bin(ts, 1m) | extend stable = symbol in (""USDT-USD"", ""USDC-USD"") | extend ecart_bps = iff(stable, round((mid - 1.0) * 10000, 2), real(null)), ecart_min_bps = iff(stable, round((mid_min - 1.0) * 10000, 2), real(null)) | extend etat = case(not(stable), """", abs(ecart_min_bps) >= 50, ""Décrochage"", abs(ecart_min_bps) >= 20, ""Sous surveillance"", ""Ancré""), serie = strcat(replace_string(symbol, ""-USD"", """"), "" · "", case(venue == ""BINANCE"", ""Binance"", venue == ""KRAKEN"", ""Kraken"", ""Coinbase"")) | project venue, symbol, minute, serie, spread_bps, depth_5bps, depth_20bps, mid, mid_min, imbalance, latency_ms, carnets = toint(carnets), choc = toint(choc), ecart_bps, ecart_min_bps, etat", [MaxRows = null, MaxSize = null, NoTruncate = null, AdditionalSetStatements = null]),
					Types = Table.TransformColumnTypes(Source, {{"venue", type text}, {"symbol", type text}, {"minute", type datetime}, {"serie", type text}, {"spread_bps", type number}, {"depth_5bps", type number}, {"depth_20bps", type number}, {"mid", type number}, {"mid_min", type number}, {"imbalance", type number}, {"latency_ms", type number}, {"carnets", Int64.Type}, {"choc", Int64.Type}, {"ecart_bps", type number}, {"ecart_min_bps", type number}, {"etat", type text}}, "en-US")
				in
					Types

	annotation PBI_ResultType = Table

