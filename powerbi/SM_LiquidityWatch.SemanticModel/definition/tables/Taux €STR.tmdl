/// Taux €STR quotidien (BCE) depuis 2024, lu dans le lakehouse par raccourci OneLake
table 'Taux €STR'
	lineageTag: 17ce1eda-8bb2-5aff-86a7-73f25866124c

	column 'Date'
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: bb730059-2eed-5eca-8070-ff3efa7bdd29
		summarizeBy: none
		sourceColumn: rate_date

		annotation SummarizationSetBy = Automatic

	column '€STR (%)'
		dataType: double
		formatString: 0.000
		lineageTag: 590e03a8-70cd-5cec-ae1f-720271202abc
		summarizeBy: none
		sourceColumn: estr_pct

		annotation SummarizationSetBy = Automatic

	column 'Variation (pb)'
		dataType: double
		formatString: +0.0;-0.0;0.0
		lineageTag: 55f2a654-a53e-5e1a-8d89-d3a98851b7b8
		summarizeBy: none
		sourceColumn: estr_change_bp

		annotation SummarizationSetBy = Automatic

	partition 'Taux €STR' = m
		mode: import
		source =
				let
					Source = AzureDataExplorer.Contents(Cluster, Base, "external_table(""macro_estr"") | project rate_date, estr_pct, estr_change_bp | order by rate_date asc", [MaxRows = null, MaxSize = null, NoTruncate = null, AdditionalSetStatements = null]),
					Types = Table.TransformColumnTypes(Source, {{"rate_date", type datetime}, {"estr_pct", type number}, {"estr_change_bp", type number}}, "en-US")
				in
					Types

	annotation PBI_ResultType = Table

