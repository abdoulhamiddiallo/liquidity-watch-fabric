/// Écartements anormaux de fourchette par plateforme et marché, au pas de 30 secondes
table 'Anomalies'
	lineageTag: 9082ab07-7f74-5d1c-9cb0-f9335dc2b62e

	column 'Clé'
		dataType: string
		isHidden
		lineageTag: b509caad-1c24-5d40-adb2-0f9582da00eb
		summarizeBy: none
		sourceColumn: cle

		annotation SummarizationSetBy = Automatic

	column 'Horodatage UTC'
		dataType: dateTime
		formatString: dd/mm/yyyy hh:nn:ss
