		summarizeBy: none
		sourceColumn: spread_bps

		annotation SummarizationSetBy = Automatic

	column 'Fourchette habituelle (pb)'
		dataType: double
		formatString: 0.00
		lineageTag: 83626b1d-9f60-5cc3-ad4a-0b553f5cd146
