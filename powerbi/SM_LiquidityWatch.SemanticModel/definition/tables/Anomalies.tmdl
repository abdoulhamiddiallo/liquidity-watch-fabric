		lineageTag: afeb2b13-5951-5f8f-8c6d-8c8cd82d5bcd
		summarizeBy: none
		sourceColumn: heure

		annotation SummarizationSetBy = Automatic

	column 'Minute'
		dataType: dateTime
		isHidden
		lineageTag: b08e22c3-da0b-5e11-b2aa-2eb896decdb6
		summarizeBy: none
		sourceColumn: minute

