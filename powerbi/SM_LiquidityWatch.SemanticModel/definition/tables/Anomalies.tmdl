		dataType: double
		formatString: 0.00
		lineageTag: a0910d65-a62f-57f5-9e10-fefd59bb5d41
		summarizeBy: none
		sourceColumn: exces_bps

		annotation SummarizationSetBy = Automatic

	column 'Score'
		dataType: double
		formatString: 0.0
		lineageTag: 58833f7c-d8ce-511e-b49f-3d82a895bd6d
		summarizeBy: none
		sourceColumn: score

		annotation SummarizationSetBy = Automatic

	partition 'Anomalies' = m
		mode: import
		source =
				let
					Source = AzureDataExplorer.Contents(Cluster, Base, "let p = lw_book_silver | summarize spread = avg(spread_bps) by venue, symbol, t = bin(ts, 30s); let b = p | summarize med = percentile(spread, 50), q1 = percentile(spread, 25), q3 = percentile(spread, 75) by venue, symbol; p | join kind=inner b on venue, symbol | extend echelle = max_of((q3 - q1) / 1.349, med * 0.1, 0.05) | extend score = round((spread - med) / echelle, 1) | where score >= 4 and spread - med >= 0.5 | project cle = strcat(venue, "" "", symbol, "" "", format_datetime(t, ""yyyy-MM-dd HH:mm:ss"")), ts = t, heure = datetime_utc_to_local(t, ""Europe/Paris""), minute = bin(t, 1m), venue, symbol, spread_bps = round(spread, 2), attendu_bps = round(med, 2), exces_bps = round(spread - med, 2), score", [MaxRows = null, MaxSize = null, NoTruncate = null, AdditionalSetStatements = null]),
					Types = Table.TransformColumnTypes(Source, {{"cle", type text}, {"ts", type datetime}, {"heure", type datetime}, {"minute", type datetime}, {"venue", type text}, {"symbol", type text}, {"spread_bps", type number}, {"attendu_bps", type number}, {"exces_bps", type number}, {"score", type number}}, "en-US")
				in
					Types

	annotation PBI_ResultType = Table

